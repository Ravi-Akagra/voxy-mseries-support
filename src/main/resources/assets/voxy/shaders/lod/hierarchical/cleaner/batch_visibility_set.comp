#version 430 core
//
layout(local_size_x=128) in;

layout(binding = VISIBILITY_BUFFER_BINDING, std430) restrict writeonly buffer VisibilityDataBuffer {
    uint[] visiblity;
};

layout(binding = LIST_BUFFER_BINDING, std430) restrict readonly buffer SetListBuffer {
    uint[] ids;
};

// M9 migration: location-based uniforms wrapped in a UBO block so the
// shader compiles on Metal/Vulkan (which have no glUniform equivalent).
// GL backend pushes via setBytes → glBindBufferRange(GL_UNIFORM_BUFFER, ...).
// Field order matches the byte layout the Java side writes.
#ifndef PUSH_BINDING
#define PUSH_BINDING 14
#endif
layout(binding = PUSH_BINDING, std140) uniform Push {
    uint count;
    uint setTo;
};
void main() {
    uint id = gl_GlobalInvocationID.x;
    if (count <= id) {
        return;
    }
    uint pos = ids[id];
    //Metal fix: bool-select mix() overload miscompiles via SPIRV-Cross MSL (see frustum.glsl)
    visiblity[pos&((1u<<31)-1)] = (pos&(1u<<31)) == 0 ? uint(-1) : setTo;
}